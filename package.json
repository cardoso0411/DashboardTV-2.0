{
  "name": "app",
  "version": "1.0.0",
  "description": "",
  "main": "backend/server.js",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n backend,frontend -c blue,green \"npm:dev:backend:if-needed\" \"npm:dev:frontend\"",
    "dev:backend": "cross-env PORT=3339 node backend/server.js",
    "dev:backend:if-needed": "cross-env PORT=3339 node backend/dev-server.js",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build": "tsc -b frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts --host 0.0.0.0",
    "test": "node --test backend/*.test.js",
    "start": "npm run build && node backend/server.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chart.js": "^4.5.1",
    "express": "^4.19.2",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^3.1.0",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.5.4",
    "vite": "^4.5.11"
  }
}
